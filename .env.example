# ── Resend (email delivery) ────────────────────────────────────────────────
# Sign up at https://resend.com, verify your domain, and create an API key.
# See lib/emails/templates.ts for full setup instructions.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# The "from" address for booking/fleet-enquiry emails.
# Must be a verified sender on your Resend domain. Sent no-reply; customer
# replies are routed via the replyTo header to the monitored inbox instead.
BOOKING_FROM_EMAIL=noreply@truetodetail.co.uk

# ── Optional webhook (Zapier / Make / n8n) ────────────────────────────────
# If set, the full booking record is POSTed here as JSON after every booking.
BOOKING_WEBHOOK_URL=

# ── AI Support Chat (optional, free) ───────────────────────────────────────
# Powers the "Need a hand?" chat widget with real AI-driven answers grounded
# in the site's own packages/pricing/coverage info (see app/api/support-chat/route.ts
# and lib/chat/). Both providers below have genuinely free tiers (no card
# required); Gemini is tried first, Groq second if Gemini's daily quota is
# used up, and a deterministic rule-based assistant (always available, no
# key needed) is the final fallback if both are unset or unavailable —
# the widget never requires payment to function.
#
# Gemini (primary): get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq (secondary, independent quota): get a free key at https://console.groq.com/keys
GROQ_API_KEY=
